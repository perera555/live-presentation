# Claude API key — writes the slides and speech, and powers the chat. https://platform.claude.com
ANTHROPIC_API_KEY=

# D-ID API key — animates the uploaded photo into a talking video. https://studio.d-id.com (Account → API key)
# Paste the key exactly as D-ID shows it (it is already in "user:password" base64 form).
# Without it, the app still works with a voice-over preview instead of a talking video.
DID_API_KEY=

# ElevenLabs API key — clones the presenter's own voice. https://elevenlabs.io (Starter plan or higher for voice cloning)
ELEVENLABS_API_KEY=

# Your contact details, shown in the app (WhatsApp button + Zoom link). Visible to every visitor.
NEXT_PUBLIC_CONTACT_NAME=
# WhatsApp number with country code, e.g. +94771234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Your Zoom personal meeting link, e.g. https://us05web.zoom.us/j/1234567890?pwd=...
NEXT_PUBLIC_ZOOM_LINK=
